# Media health check settings.
# Copy this file to config/env/media-health-check.env on the production host if
# the default paths, thresholds, or health checks need to change.

PROD_ROOT=/home/mediaserver/ManageMediaServer
LOG_DIR=/mnt/data/config/media-health-check/logs

IMMICH_COMPOSE_DIR=/home/mediaserver/ManageMediaServer/docker/immich
JELLYFIN_COMPOSE_DIR=/home/mediaserver/ManageMediaServer/docker/jellyfin

IMMICH_HEALTH_URL=http://127.0.0.1:2283
JELLYFIN_HEALTH_URL=http://127.0.0.1:8096
HTTP_MAX_TIME_SECONDS=10

RCLONE_TIMER=rclone-media-sync.timer
REQUIRE_RCLONE_TIMER_ENABLED=true

ROOT_PATH=/
DATA_PATH=/mnt/data
BACKUP_PATH=/mnt/backup
ROOT_MIN_FREE_KIB=1048576
DATA_MIN_FREE_KIB=1048576
BACKUP_MIN_FREE_KIB=1048576
REQUIRE_BACKUP_MOUNT=true

# Failure notifications are sent when notification.env enables Discord.
# Set true if you want periodic success notifications too.
NOTIFY_ON_SUCCESS=false
