# Media app update settings.
# Copy this file to config/env/media-app-update.env on the production host if
# the default paths, major ranges, thresholds, or health checks need to change.

PROD_ROOT=/home/mediaserver/ManageMediaServer
BACKUP_ROOT=/mnt/backup
LOG_DIR=/mnt/data/config/media-app-update/logs

ROOT_MIN_FREE_KIB=1048576
DATA_MIN_FREE_KIB=1048576
BACKUP_MIN_FREE_KIB=1048576

IMMICH_ALLOWED_MAJOR=2
JELLYFIN_ALLOWED_MAJOR=10

IMMICH_COMPOSE_DIR=/home/mediaserver/ManageMediaServer/docker/immich
JELLYFIN_COMPOSE_DIR=/home/mediaserver/ManageMediaServer/docker/jellyfin

IMMICH_HEALTH_URL=http://127.0.0.1:2283
JELLYFIN_HEALTH_URL=http://127.0.0.1:8096
HEALTH_RETRIES=12
HEALTH_RETRY_SLEEP_SECONDS=10

REQUIRE_MEDIA_BACKUP_SUCCESS=true
