# Media OS update settings.
# Installed root settings live in /etc/manage-media-maintenance/media-os-update.env.
# Edit that protected copy with sudo if
# the default paths, thresholds, or update behavior need to change.

LOG_DIR=/var/log/manage-media-maintenance/os
BACKUP_ROOT=/mnt/backup

ROOT_MIN_FREE_KIB=1048576
DATA_MIN_FREE_KIB=1048576
BACKUP_MIN_FREE_KIB=1048576

RUN_APT_UPDATE=true
RUN_APT_UPGRADE=true
APT_UPGRADE_COMMAND=full-upgrade
RUN_APT_AUTOREMOVE=false
RUN_SNAP_REFRESH=true
APT_LOCK_TIMEOUT_SECONDS=600
