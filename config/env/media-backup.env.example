# Media backup settings.
# Copy this file to config/env/media-backup.env on the production host if
# the default paths or thresholds need to be changed.

BACKUP_ROOT=/mnt/backup
BACKUP_MIN_FREE_KIB=1048576

IMMICH_UPLOAD_SOURCE=/mnt/data/immich/upload
IMMICH_UPLOAD_BACKUP=/mnt/backup/immich-upload

IMMICH_EXTERNAL_SOURCE=/mnt/data/immich/external
IMMICH_EXTERNAL_BACKUP=/mnt/backup/immich-backup

JELLYFIN_MEDIA_SOURCE=/mnt/data/jellyfin/music-videos
JELLYFIN_MEDIA_BACKUP=/mnt/backup/jellyfin-backup

LOG_DIR=/mnt/data/config/media-backup/logs
