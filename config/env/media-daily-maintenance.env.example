# Daily maintenance settings.
# The daily maintenance job is the single scheduled entry point for backup,
# app updates, rclone sync, OS package updates, reboot handling, and Discord
# summary notification.

PROD_ROOT=/home/mediaserver/ManageMediaServer
LOG_DIR=/mnt/data/config/media-daily-maintenance/logs
CHILD_USER=mediaserver

RUN_MEDIA_BACKUP=true
RUN_MEDIA_APP_UPDATE=true
RUN_RCLONE_SYNC=true
RUN_OS_UPDATE=true
RCLONE_SYNC_NO_DELETE=false

AUTO_REBOOT=true
AUTO_REBOOT_DELAY_MINUTES=5

MEDIA_BACKUP_SCRIPT=/home/mediaserver/ManageMediaServer/scripts/ops/media-backup.sh
MEDIA_APP_UPDATE_SCRIPT=/home/mediaserver/ManageMediaServer/scripts/ops/media-app-update.sh
RCLONE_MEDIA_SYNC_SCRIPT=/home/mediaserver/ManageMediaServer/scripts/ops/rclone-media-sync.sh
MEDIA_OS_UPDATE_SCRIPT=/home/mediaserver/ManageMediaServer/scripts/ops/media-os-update.sh
