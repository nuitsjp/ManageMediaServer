[Unit]
Description=Restrict media Docker published ports to home LAN and Tailscale
After=docker.service tailscaled.service
Wants=docker.service tailscaled.service

[Service]
Type=oneshot
WorkingDirectory=/home/mediaserver/ManageMediaServer
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/mediaserver/ManageMediaServer/config/env/media-firewall.env
ExecStart=/usr/bin/bash /home/mediaserver/ManageMediaServer/scripts/ops/apply-media-firewall.sh apply
ExecStop=/usr/bin/bash /home/mediaserver/ManageMediaServer/scripts/ops/apply-media-firewall.sh remove
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
